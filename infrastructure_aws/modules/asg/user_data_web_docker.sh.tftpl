#!/bin/bash
# ========================================
# Web Tier User-Data - Docker Deployment
# Purpose: Pull and run frontend container
# ========================================

set -xeuo pipefail

log() { echo "[web-docker] $*"; }

# ===== Variables from Terraform =====
ECR_REGISTRY="${ecr_registry}"
FRONTEND_IMAGE_TAG="${frontend_image_tag}"
INTERNAL_ALB_DNS="${internal_alb_dns}"
AWS_REGION="${aws_region}"

log "Starting web tier deployment..."
log "Image: $ECR_REGISTRY/ecommerce-frontend:$FRONTEND_IMAGE_TAG"

# ===== 1. Login to ECR =====
log "Logging into ECR..."
aws ecr get-login-password --region $AWS_REGION | \
  docker login --username AWS --password-stdin $ECR_REGISTRY

# ===== 2. Pull Frontend Image =====
log "Pulling frontend image..."
docker pull $ECR_REGISTRY/ecommerce-frontend:$FRONTEND_IMAGE_TAG

# ===== 3. Stop old container (if exists) =====
log "Stopping old container..."
docker stop ecommerce-frontend || true
docker rm ecommerce-frontend || true

# ===== 4. Update nginx.conf with Internal ALB DNS =====
# Create temporary container to extract and modify nginx.conf
log "Updating nginx.conf with Internal ALB DNS..."
docker create --name temp-frontend $ECR_REGISTRY/ecommerce-frontend:$FRONTEND_IMAGE_TAG
docker cp temp-frontend:/etc/nginx/conf.d/default.conf /tmp/default.conf
docker rm temp-frontend

# Replace placeholder with actual Internal ALB DNS
sed -i "s|http://backend:3000|http://$INTERNAL_ALB_DNS|g" /tmp/default.conf

# ===== 5. Run Frontend Container =====
log "Starting frontend container..."
docker run -d \
  --name ecommerce-frontend \
  --restart always \
  -p 80:80 \
  -v /tmp/default.conf:/etc/nginx/conf.d/default.conf:ro \
  --log-driver=awslogs \
  --log-opt awslogs-group="/aws/ec2/ecommerce/web" \
  --log-opt awslogs-region=$AWS_REGION \
  --log-opt awslogs-stream="$(ec2-metadata --instance-id | cut -d ' ' -f 2)" \
  $ECR_REGISTRY/ecommerce-frontend:$FRONTEND_IMAGE_TAG

# ===== 6. Health Check =====
log "Waiting for container to be healthy..."
for i in {1..30}; do
  if docker exec ecommerce-frontend wget -q -O- http://localhost/health &>/dev/null; then
    log "Frontend container is healthy!"
    break
  fi
  log "Waiting for health check... ($i/30)"
  sleep 2
done

# ===== 7. CloudWatch Agent (optional) =====
log "Configuring CloudWatch agent..."
cat > /opt/aws/amazon-cloudwatch-agent/etc/config.json <<EOF
{
  "metrics": {
    "namespace": "Ecommerce/Web",
    "metrics_collected": {
      "cpu": {
        "measurement": [{"name": "cpu_usage_idle", "rename": "CPU_IDLE", "unit": "Percent"}],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": [{"name": "mem_used_percent", "rename": "MEM_USED", "unit": "Percent"}],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "/aws/ec2/ecommerce/web",
            "log_stream_name": "{instance_id}/cloud-init"
          }
        ]
      }
    }
  }
}
EOF

# Start CloudWatch agent
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json \
  -s || log "CloudWatch agent not available"

log "Web tier deployment complete!"
log "Container status:"
docker ps -a --filter name=ecommerce-frontend
