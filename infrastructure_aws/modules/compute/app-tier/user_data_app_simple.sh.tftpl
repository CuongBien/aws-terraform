#!/bin/bash
set -xeuo pipefail

# ========= Inputs from Terraform =========
DB_HOST="${db_host}"
DB_USER="${db_username}"
DB_PASS="${db_password}"
DB_NAME="${db_name}"
PROJECT="${project_name}"
ENVIRONMENT="${environment}"

log(){ echo "[app-user-data] $*"; }

# ========= 1) Apache + PHP đã được baked vào AMI bởi Packer =========
# Backend API code đã có sẵn tại /var/www/html/api/

# Ensure Apache is running
sudo systemctl enable --now httpd

# ========= 2) Healthcheck file =========
echo "ok" | sudo tee /var/www/html/health.txt >/dev/null
sudo chown apache:apache /var/www/html/health.txt
sudo chmod 644 /var/www/html/health.txt

# ========= 3) Update DB connection config =========
# Tạo config file cho backend API để kết nối DB
cat > /tmp/db_config.php <<PHP
<?php
// Database Configuration - Generated by user-data
define('DB_HOST', '${db_host}');
define('DB_USER', '${db_username}');
define('DB_PASS', '${db_password}');
define('DB_NAME', '${db_name}');
define('DB_PORT', '3306');

// Create connection helper
function get_db_connection() {
    \$conn = new mysqli(DB_HOST, DB_USER, DB_PASS, DB_NAME, DB_PORT);
    if (\$conn->connect_error) {
        error_log("DB Connection failed: " . \$conn->connect_error);
        return null;
    }
    \$conn->set_charset("utf8mb4");
    return \$conn;
}
?>
PHP

sudo mv /tmp/db_config.php /var/www/html/api/db_config.php
sudo chown apache:apache /var/www/html/api/db_config.php
sudo chmod 644 /var/www/html/api/db_config.php

# ========= 4) Initialize Database =========
MYSQL=$(command -v mysql || command -v mariadb || true)
if [ -n "$MYSQL" ]; then
  log "Creating database if not exists..."
  "$MYSQL" -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" \
    -e "CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" || true

  # Check if messages table exists
  TABLE_COUNT=$("$MYSQL" -N -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" \
    -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='messages';" 2>/dev/null || echo 0)

  if [ "$TABLE_COUNT" = "0" ]; then
    log "Creating messages table..."
    "$MYSQL" -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" <<SQL
CREATE TABLE IF NOT EXISTS messages (
  id INT AUTO_INCREMENT PRIMARY KEY,
  message TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_created (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Insert sample data
INSERT INTO messages (message) VALUES 
  ('Welcome to the three-tier architecture demo!'),
  ('This message is stored in RDS MySQL'),
  ('Blue/Green deployment is working!');
SQL
    log "Messages table created with sample data"
  else
    log "Messages table already exists (count=$TABLE_COUNT)"
  fi
else
  log "No mysql client found; skip DB init"
fi

# ========= 5) Set Permissions =========
sudo chown -R apache:apache /var/www/html
sudo chmod -R 755 /var/www/html
sudo restorecon -Rv /var/www/html || true

# ========= 6) CloudWatch Agent =========
if [ -x /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
  ACCESS_LOG="/var/log/httpd/access_log"
  ERROR_LOG="/var/log/httpd/error_log"

  sudo mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
  cat >/tmp/cw.json <<JSON
{
  "agent": { "run_as_user": "root" },
  "logs": { "logs_collected": { "files": { "collect_list": [
    { "file_path": "$ACCESS_LOG", "log_group_name": "$PROJECT-app-$ENVIRONMENT-access", "log_stream_name": "{instance_id}" },
    { "file_path": "$ERROR_LOG",  "log_group_name": "$PROJECT-app-$ENVIRONMENT-error",  "log_stream_name": "{instance_id}" }
  ]}}}
}
JSON
  sudo mv /tmp/cw.json /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
  /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s
  log "CloudWatch Agent configured"
fi

# ========= 7) Reload Apache =========
sudo systemctl reload httpd

log "App tier user-data completed - Backend API is baked in AMI, DB config updated"
