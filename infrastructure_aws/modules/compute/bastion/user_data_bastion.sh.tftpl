#!/bin/bash
set -euo pipefail

log() { echo "[bastion-user-data] $*"; }

log "Starting bastion host configuration for ${project_name}"

# Update system
log "Updating system packages..."
dnf -y update

# Install essential tools
log "Installing essential tools..."
dnf -y install git curl wget htop tmux vim

# Install AWS CLI v2 (if not already installed)
if ! command -v aws &> /dev/null; then
    log "Installing AWS CLI v2..."
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
    unzip -q awscliv2.zip
    ./aws/install
    rm -rf aws awscliv2.zip
fi

# Install Session Manager plugin for SSH over SSM
log "Installing Session Manager plugin..."
dnf install -y https://s3.amazonaws.com/session-manager-downloads/plugin/latest/linux_64bit/session-manager-plugin.rpm || true

# Configure SSH banner
log "Configuring SSH banner..."
cat > /etc/ssh/sshd_banner <<'EOF'
##########################################
#   Bastion Host - ${project_name}      #
#   Authorized Access Only               #
##########################################
EOF
sed -i 's|#Banner none|Banner /etc/ssh/sshd_banner|g' /etc/ssh/sshd_config
systemctl restart sshd || true

# Create log directory
mkdir -p /var/log/bastion
chmod 755 /var/log/bastion

log "Bastion host configuration completed successfully"
