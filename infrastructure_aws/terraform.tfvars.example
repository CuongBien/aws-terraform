# ========================================
# TERRAFORM VARIABLES - EXAMPLE VALUES
# ========================================
# Copy this file to terraform.tfvars and customize the values
# ========================================

# ===== PROJECT CONFIGURATION =====
project_name = "pbl4-three-tier"
environment  = "prod"

# ===== NETWORKING =====
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]

public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]

private_subnet_cidrs = [
  "10.0.11.0/24", "10.0.12.0/24", # Web tier
  "10.0.21.0/24", "10.0.22.0/24", # App tier
  "10.0.31.0/24", "10.0.32.0/24"  # DB tier
]

enable_nat_gateway      = true
enable_vpn_gateway      = false
enable_ssm_vpc_endpoint = true

# ===== EC2 CONFIGURATION =====
key_pair_name = "pbl4-three-tier-key"

# Web Tier
web_ami_id           = "ami-039c813819c142011" # Amazon Linux 2023 with Nginx
web_ami_id_green     = ""                      # Leave empty to use same as blue
web_instance_type    = "t3.micro"
web_min_size         = 1
web_max_size         = 3
web_desired_capacity = 1

# App Tier
app_ami_id           = "ami-0540d3917795ab713" # Amazon Linux 2023 with OpenCart
app_ami_id_green     = ""                      # Leave empty to use same as blue
app_instance_type    = "t3.micro"
app_min_size         = 1
app_max_size         = 3
app_desired_capacity = 1

# Bastion
bastion_ami_id            = ""         # Leave empty for latest Amazon Linux 2023
bastion_instance_type     = "t3.micro"
bastion_root_volume_size  = 8
bastion_allowed_cidrs     = ["YOUR_IP_HERE/32"] # Replace with your IP

# ===== DATABASE CONFIGURATION =====
db_engine_version       = "8.0"
db_instance_class       = "db.t3.micro"
db_allocated_storage    = 20
db_username             = "admin"           # Change this!
db_password             = "ChangeMe123!"    # Change this! Min 8 characters
db_name                 = "opencart_db"
db_multi_az             = false             # Set true for production
db_backup_retention_period = 7
db_backup_window        = "03:00-04:00"
db_maintenance_window   = "sun:04:00-sun:05:00"
db_deletion_protection  = false             # Set true for production
db_skip_final_snapshot  = true              # Set false for production

# ===== BLUE/GREEN DEPLOYMENT =====
# Blue environment (current/stable version)
enable_blue_env            = true
traffic_distribution_blue  = 100

# Green environment (new version for testing)
enable_green_env           = false
traffic_distribution_green = 0

# ===== MONITORING =====
alarm_email_endpoints = ["your-email@example.com"] # Replace with your email
